################################################################################
# backend-s3.tf.example — opt-in S3 backend for remote state + native locking.
#
# WHY:
#   - Local state (the default in this tree) is fine for a single operator
#     on one machine. The moment a second person, a CI runner, or even just
#     a second laptop touches this Terraform, local state breaks.
#   - S3 backend gives you durable, versioned, encrypted state with shared
#     access — and the `use_lockfile = true` option provides native locking
#     via S3 conditional writes (GA in **Terraform 1.11**, experimental in
#     1.10). **DynamoDB lock table is no longer required** (and DynamoDB
#     locking is deprecated). The S3 backend is built into Terraform itself;
#     the hashicorp/aws provider version does not matter here.
#
# HOW TO USE:
#   1. Run `./bootstrap-state.sh <YOUR-UNIQUE-BUCKET-NAME> [REGION] [KMS-KEY-ARN]`
#      first — creates the S3 bucket with versioning, encryption (SSE-KMS
#      when you pass a key ARN), public-access-block and a TLS-only policy.
#   2. Copy this file: `cp backend-s3.tf.example backend-s3.tf`
#   3. Edit `backend-s3.tf` and set the bucket + region to match.
#   4. Run `terraform init -migrate-state` — Terraform copies the local
#      `terraform.tfstate` into S3 and uses S3 for all future operations.
#   5. (Optional) `rm terraform.tfstate terraform.tfstate.backup` once you
#      confirm S3 state works.
#
# COST: S3 storage for the state file is < $0.01/month even for huge states.
#   Versioning + 90-day lifecycle (set by bootstrap-state.sh) caps growth.
#
# TEARDOWN: Before `terraform destroy`, the state must be readable. The S3
#   bucket should NOT be destroyed by this Terraform — keep it across
#   apply/destroy cycles. Delete the bucket manually only after you're
#   permanently done.
################################################################################

terraform {
  backend "s3" {
    # Replace with YOUR globally-unique bucket name. AWS S3 bucket names share
    # a global namespace, so something like "tfstate-bookstore-<YOUR-INITIALS>"
    # works. Must match the name you passed to bootstrap-state.sh.
    bucket = "REPLACE-WITH-YOUR-BUCKET-NAME"

    # Object key inside the bucket. Putting it under a project-named prefix
    # makes it easy to reuse the same bucket for multiple Terraform trees.
    key = "bookstore-platform/terraform.tfstate"

    # Must match the bucket's region (S3 bucket regions are immutable once set).
    region = "ap-south-1"

    # Server-side encryption for the state at rest. bootstrap-state.sh sets
    # the bucket default (SSE-S3, or SSE-KMS when given a key ARN).
    encrypt = true

    # **NATIVE S3 STATE LOCKING — no DynamoDB table required.**
    # GA in Terraform 1.11 (experimental in 1.10). The previous pattern of
    # `dynamodb_table = "tf-locks"` is deprecated and can be deleted.
    # The lock is the object <key>.tflock: whoever plans/applies with a lock
    # needs s3:GetObject, s3:PutObject and s3:DeleteObject on it. A run killed
    # mid-apply leaves it behind; after confirming nothing is running,
    # `terraform force-unlock <LOCK_ID>` removes it.
    use_lockfile = true

    # RECOMMENDED beyond a lab: SSE-KMS with a customer-managed key. With
    # SSE-S3, s3:GetObject on the bucket is enough to read state, and state
    # holds every attribute Terraform manages (README: "What is in state").
    # With a CMK, reading state also needs kms:Decrypt under a key policy you
    # control, and every decrypt is in CloudTrail. Whoever reads state then
    # needs kms:Decrypt on the key; whoever writes state or the .tflock
    # object also needs kms:GenerateDataKey (and the key policy must allow
    # both). The CI roles are listed in .github/workflows/terraform.yml.
    #   kms_key_id = "arn:aws:kms:ap-south-1:<ACCOUNT-ID>:key/<KEY-ID>"
  }
}
